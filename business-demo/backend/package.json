  "scripts": {
    "build": "tsc -p tsconfig.business.json",
    "start": "node dist/business/main.js",
    "start:business": "node dist/business/main.js",
    "test:business": "tsc -p tsconfig.test.json && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=../artifacts/business-tests.xml test-build/business/business.spec.js",
    "test:core": "npm run build && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=../artifacts/core-tests.xml scripts/business-core.test.cjs",
    "test": "npm run test:core && npm run test:business",
    "pretest:core": "node scripts/prepare-test-artifacts.cjs",
    "pretest:business": "node scripts/prepare-test-artifacts.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
