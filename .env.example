# Synthetic, in-memory backend mode; no database required.
DATABASE_URL=fixture://local
APP_NAME=diet-backend
APP_PORT=3002
APP_HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
PRISMA_LOG_LEVEL=warn
# Optional guard for the existing backend API (not used by the read-only replay demo).
DEMO_AUTH_TOKEN=
# For a separate local PostgreSQL database, replace DATABASE_URL with:
# postgresql://diet_demo:local_demo_only@127.0.0.1:55432/diet_demo?schema=public
